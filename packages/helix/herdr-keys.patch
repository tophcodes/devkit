+/// The keys the herdr workbench mods press, since herdr-core cannot type ":".
+/// Each command reads its argument from a file next to the one HERDR_OPEN
+/// names; `sh -c` keeps them independent of `editor.shell`.
+/// - A-F12 opens the path in the HERDR_OPEN file.
+/// - A-F11 loads the theme the workbench-tabs mod writes from herdr's colors.
+/// - A-F10 diffs every document against the commit id in `$HERDR_OPEN.base`
+///   (empty for HEAD).
+/// - A-F9 diffs the current document against the file named in
+///   `$HERDR_OPEN.base-file`.
+const HERDR_KEYS: &str = r#"
+[normal]
+A-F12 = ":open %sh{sh -c 'cat \"$HERDR_OPEN\"'}"
+A-F11 = ":theme herdr"
+A-F10 = ":diff-base %sh{sh -c 'cat \"$HERDR_OPEN.base\" 2>/dev/null; true'}"
+A-F9 = ":diff-base-file %sh{sh -c 'cat \"$HERDR_OPEN.base-file\"'}"
+"#;
+
+fn herdr_keys() -> HashMap<Mode, KeyTrie> {
+    toml::from_str(HERDR_KEYS).expect("the herdr keys parse")
+}
