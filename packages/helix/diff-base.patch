+/// Sets the commit every document's diff base is read from, HEAD without an
+/// argument, and recomputes the diffs of the open documents. The text of a
+/// document stays as it is.
+fn diff_base(cx: &mut compositor::Context, args: Args, event: PromptEvent) -> anyhow::Result<()> {
+    if event != PromptEvent::Validate {
+        return Ok(());
+    }
+
+    let base = args.first().map(AsRef::as_ref);
+    cx.editor.diff_providers.set_base(base);
+    let providers = cx.editor.diff_providers.clone();
+    // A document outside every repository keeps its diff, which may come from
+    // :diff-base-file.
+    for doc in cx.editor.documents_mut() {
+        let Some(path) = doc.path().cloned() else {
+            continue;
+        };
+        if let Some(diff_base) = providers.get_diff_base(&path) {
+            doc.set_diff_base(diff_base);
+        }
+    }
+    cx.editor
+        .set_status(format!("Diff base is now {}", base.unwrap_or("HEAD")));
+    Ok(())
+}
+
+/// Takes the current document's diff base from the contents of a file.
+fn diff_base_file(
+    cx: &mut compositor::Context,
+    args: Args,
+    event: PromptEvent,
+) -> anyhow::Result<()> {
+    if event != PromptEvent::Validate {
+        return Ok(());
+    }
+
+    let path = helix_stdx::path::expand_tilde(Path::new(&args[0]));
+    let diff_base = std::fs::read(&path)
+        .map_err(|err| anyhow!("Could not read '{}': {err}", path.display()))?;
+    doc_mut!(cx.editor).set_diff_base(diff_base);
+    Ok(())
+}
+
